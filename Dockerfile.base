# ------------------------------------------------------------
# Base Development Image (Ubuntu)
#
# This image contains only general development tools that are
# useful regardless of programming language.
#
# Language specific Dockerfiles will extend this image.
# ------------------------------------------------------------

# Ubuntu release to build from. Override at build time, e.g.:
#   docker build --build-arg UBUNTU_IMAGE=ubuntu:22.04 ...
ARG UBUNTU_IMAGE=ubuntu:24.04
FROM ${UBUNTU_IMAGE}

# Disable interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install common development utilities
RUN apt-get update && apt-get install -y     git     curl     wget     vim     nano     build-essential     sudo     tmux     htop     tree     unzip	ca-certificates     bash-completion && rm -rf /var/lib/apt/lists/*

ARG UID=1000
ARG GID=1000
ARG USERNAME=dev

# Check whether a user of group exists with UID and GID
# If yes then take the necessary steps
RUN set -eux; \
    if id -u $UID >/dev/null 2>&1; then \
        EXISTING_USER=$(getent passwd $UID | cut -d: -f1); \
        usermod -l $USERNAME -d /home/$USERNAME -m $EXISTING_USER; \
        groupmod -n $USERNAME $(getent group $GID | cut -d: -f1); \
    else \
        if ! getent group $GID >/dev/null 2>&1; then \
            groupadd -g $GID $USERNAME; \
        fi; \
        useradd -m -u $UID -g $GID -s /bin/bash $USERNAME; \
    fi; \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER $USERNAME

# Workspace directory where projects will be mounted
WORKDIR /workspace

# Default command just opens a shell
CMD ["bash"]
